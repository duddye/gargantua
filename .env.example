# Copia questo file in .env.local e compila i valori.
# Su Vercel vanno impostati in Settings → Environment Variables.

# Firma il cookie di accesso: usa un valore lungo e casuale
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEGRETO=

# Postgres. In locale (Docker):
#   docker run -d --name gargantua-pg -e POSTGRES_USER=gargantua \
#     -e POSTGRES_PASSWORD=orizzonte-locale -e POSTGRES_DB=diario \
#     -p 127.0.0.1:5433:5432 -v gargantua-pg-dati:/var/lib/postgresql/data postgres:17-alpine
# Su Vercel: database Neon dal Marketplace (crea DATABASE_URL da solo).
DATABASE_URL=postgres://gargantua:orizzonte-locale@127.0.0.1:5433/diario

# I nomi (Jo e Alix) stanno nel database: tabella "persone" (db/schema.sql).
